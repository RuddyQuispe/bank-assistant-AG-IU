# --- Obligatorias ---
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=
# Secreto para firmar los JWT (32+ caracteres). Generar con:
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Opcionales (si se omiten se usa el valor de settings.py) ---
# Obligatoria solo si MEMORY_BACKEND = "postgres" en settings.py
# DATABASE_URL=postgresql://user:password@localhost:5432/wallet

# Documentación de la API (DOCS_ENABLED=false en producción)
# DOCS_ENABLED=true
# SCALAR_PATH=/scalar
# SCALAR_THEME=default